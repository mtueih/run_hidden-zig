.{
    // 这是依赖本包的其他包所使用的默认名称。例如，当用户运行
    // `zig fetch --save <url>` 时，本字段会被用作 `dependencies` 表中的键。
    // 虽然用户可以另选一个名称，但大多数用户会沿用这里提供的值。
    //
    // 在这个名称中包含 "zig" 是多余的，因为它已经处于 Zig 的包命名空间之中。
    .name = .run_hidden,
    // 这是一个 [语义化版本](https://semver.org/)。
    // 在未来的 Zig 版本中它将被用于包的去重。
    .version = "0.0.0",
    // 它与 name 一起构成一个全局唯一的包标识符。该字段由 Zig 工具链在
    // 首次创建包时生成，此后*永不改变*。这使得我们可以无歧义地检测出
    // 某个包是另一个包的更新版本。
    //
    // 派生（fork）一个 Zig 项目时，如果上游项目仍在被维护，则应当重新生成
    // 此 id（删除该字段并运行 `zig build`）。否则该 fork 就是*敌意的*，
    // 意在夺取原项目的身份。因此建议保留下面这一行的注释，以便在修改该字段
    // 的代码评审中把它显示出来。
    .fingerprint = 0x8261d880d6223663, // 修改它具有安全与信任方面的影响。
    // 记录本包认为受支持的最低 Zig 版本。
    .minimum_zig_version = "0.17.0",
    // 该字段是可选的。
    // 每个依赖必须提供 `url` 和 `hash`，或者提供一个 `path`。
    // 可以用 `zig build --fetch` 递归地获取一个包的所有依赖。
    // 一旦所有依赖都已获取，`zig build` 就不再需要联网。
    .dependencies = .{
        // 关于通过命令行添加依赖，参见 `zig fetch --save <url>`。
        //.example = .{
        //    // 当把该字段更新为新的 URL 时，请务必同时删除对应的 `hash`，
        //    // 否则就等于在声明你期望在新 URL 上找到旧的 hash。如果 URL 的
        //    // 内容发生了变化，就会导致 hash 不匹配，从而使 zig 不再使用它。
        //    .url = "https://example.com/foo.tar.gz",
        //
        //    // 它是根据以下文件内容计算出来的：在获取 `url` 之后得到的文件
        //    // 目录，并应用了 `paths` 所给出的包含规则。
        //    //
        //    // 该字段才是真正的依据：包并非来自某个 `url`，而是来自某个
        //    // `hash`。`url` 只是获得符合该 `hash` 的包的众多镜像途径之一。
        //    .hash = "...",
        //
        //    // 提供该字段时，包位于相对于构建根目录的某个目录中。在这种情况下
        //    // 包的 hash 无关紧要，因此也不会被计算。该字段与 `url` 互斥。
        //    .path = "foo",
        //
        //    // 当它被设为 `true` 时，表示该包是惰性获取的。这意味着只有在该
        //    // 依赖实际被使用时才会去获取它。
        //    .lazy = false,
        //},
    },
    // 指定本包所包含的文件和目录集合。只有这里列出的文件和目录会被计入本包的
    // `hash`。在使用 zig 包管理器时，也只有这里列出的文件会保留在磁盘上。
    // 一般来说，应当列出编译所需的文件以及任何许可证文件。
    // 路径都相对于构建根目录。用空字符串（`""`）来表示构建根目录本身。
    // 列出的目录意味着其中所有文件（递归地）都会被包含。
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "test",
        // 例如……
        "LICENSE",
        "README.md",
    },
}
